<UserControl x:Class="LoLIdleDesktop.NotifySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="18,16,18,10">
        <!-- Ativar/desativar global -->
        <Border Background="{StaticResource BgPanel2}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,10">
            <CheckBox x:Name="NotifyEnabledCheck"
                      Style="{StaticResource DarkCheckBox}"
                      FontSize="13"
                      FontWeight="SemiBold"
                      Checked="NotifyEnabledCheck_Changed"
                      Unchecked="NotifyEnabledCheck_Changed">
                <TextBlock Text="Ativar notificações" TextWrapping="Wrap" />
            </CheckBox>
        </Border>

        <!-- Contas que notificam -->
        <TextBlock Text="Notificar de:"
                   Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="2,0,0,6" />
        <StackPanel x:Name="ContasListPanel" Margin="0,0,0,12">
            <!-- Checkboxes por conta gerados no code-behind -->
        </StackPanel>

        <!-- Tipos de notificação -->
        <TextBlock Text="Tipos de notificação:"
                   Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="2,0,0,6" />
        <StackPanel x:Name="TypesListPanel">
            <!-- Checkboxes por tipo gerados no code-behind -->
        </StackPanel>

        <!-- Poções: master switch + sub-chaves indentadas (uma por tipo de poção) -->
        <CheckBox x:Name="PotionMasterCheck"
                  Tag="potion"
                  Style="{StaticResource DarkCheckBox}"
                  FontSize="12"
                  Margin="0,0,0,6"
                  VerticalContentAlignment="Center"
                  Checked="TypeCheck_Changed"
                  Unchecked="TypeCheck_Changed"
                  Content="Poções de HP ou MP acabaram" />
        <StackPanel x:Name="PotionSubPanel" Margin="22,0,0,0">
            <CheckBox x:Name="PotionVidaCheck"
                      Tag="potion_vida"
                      Style="{StaticResource DarkCheckBox}"
                      FontSize="12"
                      Margin="0,0,0,6"
                      VerticalContentAlignment="Center"
                      Checked="TypeCheck_Changed"
                      Unchecked="TypeCheck_Changed"
                      Content="Poções de Vida" />
            <CheckBox x:Name="PotionVidaForteCheck"
                      Tag="potion_vidaF"
                      Style="{StaticResource DarkCheckBox}"
                      FontSize="12"
                      Margin="0,0,0,6"
                      VerticalContentAlignment="Center"
                      Checked="TypeCheck_Changed"
                      Unchecked="TypeCheck_Changed"
                      Content="Poções de Vida Forte" />
            <CheckBox x:Name="PotionVidaSupremaCheck"
                      Tag="potion_vidaS"
                      Style="{StaticResource DarkCheckBox}"
                      FontSize="12"
                      Margin="0,0,0,6"
                      VerticalContentAlignment="Center"
                      Checked="TypeCheck_Changed"
                      Unchecked="TypeCheck_Changed"
                      Content="Poções de Vida Suprema" />
            <CheckBox x:Name="PotionManaCheck"
                      Tag="potion_mana"
                      Style="{StaticResource DarkCheckBox}"
                      FontSize="12"
                      Margin="0,0,0,6"
                      VerticalContentAlignment="Center"
                      Checked="TypeCheck_Changed"
                      Unchecked="TypeCheck_Changed"
                      Content="Poções de Mana" />
            <CheckBox x:Name="PotionManaForteCheck"
                      Tag="potion_manaF"
                      Style="{StaticResource DarkCheckBox}"
                      FontSize="12"
                      Margin="0,0,0,6"
                      VerticalContentAlignment="Center"
                      Checked="TypeCheck_Changed"
                      Unchecked="TypeCheck_Changed"
                      Content="Poções de Mana Forte" />
        </StackPanel>

        <TextBlock x:Name="MultiAccountHint"
                   Margin="2,10,0,0"
                   FontSize="11"
                   Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap"
                   Text="Quando mais de uma conta está marcada, o balão mostra o nome da conta que gerou o aviso (ex: Yasuo — Missão concluída!)." />
    </StackPanel>
</UserControl>
