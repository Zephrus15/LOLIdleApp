<UserControl x:Class="LoLIdleDesktop.CloseBehaviorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="18,16,18,10">
        <TextBlock Text="Comportamento do botão Fechar do app."
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <!-- Opção 1: sempre perguntar -->
        <Border Background="{StaticResource BgPanel2}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,10">
            <CheckBox x:Name="AskCheck"
                      Style="{StaticResource DarkCheckBox}"
                      VerticalContentAlignment="Center"
                      Checked="Option_Checked"
                      Unchecked="Option_Unchecked">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sempre perguntar"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Abre o diálogo 'Fechar o LoL Idle?' toda vez que clicar em Fechar"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </CheckBox>
        </Border>

        <!-- Opção 2: continuar em segundo plano -->
        <Border Background="{StaticResource BgPanel2}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,10">
            <CheckBox x:Name="BackgroundCheck"
                      Style="{StaticResource DarkCheckBox}"
                      VerticalContentAlignment="Center"
                      Checked="Option_Checked"
                      Unchecked="Option_Unchecked">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sempre continuar em segundo plano"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Fecha direto para a bandeja; o jogo continua farmando"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </CheckBox>
        </Border>

        <!-- Opção 3: sair e desligar -->
        <Border Background="{StaticResource BgPanel2}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,4">
            <CheckBox x:Name="ExitCheck"
                      Style="{StaticResource DarkCheckBox}"
                      VerticalContentAlignment="Center"
                      Checked="Option_Checked"
                      Unchecked="Option_Unchecked">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Sempre sair e desligar as contas"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Encerra o app e desliga todas as contas"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                </StackPanel>
            </CheckBox>
        </Border>

        <TextBlock Text="A mudança vale na hora e fica salva para as próximas vezes."
                   Foreground="{StaticResource TextSecondary}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="2,6,0,0" />
    </StackPanel>
</UserControl>
