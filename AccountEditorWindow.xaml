<Window x:Class="LoLIdleDesktop.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar conta"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="AvatarTabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Background" Value="{StaticResource BgPanel2}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgPanel3}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OffsetButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource BgPanel2}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgPanel3}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="8"
            Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    Padding="16,10,10,10"
                    Background="{StaticResource BgPanel2}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0 0 0 1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle"
                                   Text="✏️ Editar conta"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                               FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HeaderSubtitle"
                                   Text=""
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="11"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="CloseHeaderButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Content="✕"
                            ToolTip="Concluir"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHeader_Click" />
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="14,12,14,10">
                <!-- Nome -->
                <TextBlock Text="Nome:"
                           Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="2,0,0,4" />
                <Border CornerRadius="6"
                        Background="{StaticResource BgPanel2}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        Padding="6"
                        Margin="0,0,0,12">
                    <TextBox x:Name="NameBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             CaretBrush="#E8CF8F"
                             FontSize="13"
                             Padding="2,1"
                             VerticalContentAlignment="Center"
                             TextChanged="NameBox_TextChanged" />
                </Border>

                <!-- Preview ao vivo -->
                <Grid Height="72">
                    <Border x:Name="PreviewHost"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                </Grid>

                <!-- Cor -->
                <TextBlock Text="Cor"
                           Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="2,0,0,4" />
                <StackPanel x:Name="ColorsPanel"
                            Orientation="Horizontal"
                            Margin="0,0,0,10" />

                <!-- Ícone (abas: Ícones / Campeões) -->
                <TextBlock Text="Ícone"
                           Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="2,0,0,4" />
                <StackPanel Orientation="Horizontal"
                            Margin="2,0,0,6">
                    <Button x:Name="IconsTabButton"
                            Content="Ícones"
                            Style="{StaticResource AvatarTabButton}"
                            Margin="0,0,6,0"
                            Click="IconsTab_Click" />
                    <Button x:Name="ChampionsTabButton"
                            Content="Campeões"
                            Style="{StaticResource AvatarTabButton}"
                            Click="ChampionsTab_Click" />
                </StackPanel>
                <UniformGrid x:Name="IconsPanel"
                             Columns="6"
                             Rows="2"
                             Margin="0,0,0,10" />
                <UniformGrid x:Name="ChampionsPanel"
                             Columns="6"
                             Rows="2"
                             Margin="0,0,0,10"
                             Visibility="Collapsed" />

                <!-- Imagem -->
                <TextBlock Text="Imagem"
                           Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="2,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ChooseImageButton"
                            Grid.Column="0"
                            Content="Escolher arquivo…"
                            Height="30"
                            Padding="14,0"
                            Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            FontSize="12"
                            Cursor="Hand"
                            Click="ChooseImage_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="8"
                                        Background="{StaticResource BgPanel2}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="{StaticResource BgPanel3}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="ImageHint"
                               Grid.Column="1"
                               Text="Nenhuma imagem escolhida"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <!-- Posicionamento da imagem (visível só quando há imagem) -->
                <StackPanel x:Name="ImageOffsetPanel"
                            Visibility="Collapsed"
                            Margin="0,8,0,0">
                    <TextBlock Text="Ajuste qual pedaço da imagem aparece no avatar"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               Margin="2,0,0,6" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="OffsetLeftButton"
                                Content="◀"
                                Width="40" Height="30"
                                Margin="0,0,6,0"
                                FontSize="13"
                                Style="{StaticResource OffsetButton}"
                                ToolTip="Mostrar mais a parte esquerda da imagem"
                                Click="OffsetLeft_Click" />
                        <Button x:Name="OffsetUpButton"
                                Content="▲"
                                Width="40" Height="30"
                                Margin="0,0,6,0"
                                FontSize="13"
                                Style="{StaticResource OffsetButton}"
                                ToolTip="Mostrar mais a parte de cima da imagem"
                                Click="OffsetUp_Click" />
                        <Button x:Name="OffsetDownButton"
                                Content="▼"
                                Width="40" Height="30"
                                Margin="0,0,6,0"
                                FontSize="13"
                                Style="{StaticResource OffsetButton}"
                                ToolTip="Mostrar mais a parte de baixo da imagem"
                                Click="OffsetDown_Click" />
                        <Button x:Name="OffsetRightButton"
                                Content="▶"
                                Width="40" Height="30"
                                Margin="0,0,6,0"
                                FontSize="13"
                                Style="{StaticResource OffsetButton}"
                                ToolTip="Mostrar mais a parte direita da imagem"
                                Click="OffsetRight_Click" />
                        <Button x:Name="OffsetResetButton"
                                Content="Redefinir"
                                Height="30"
                                Padding="10,0"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondary}"
                                Style="{StaticResource OffsetButton}"
                                ToolTip="Voltar ao recorte centralizado"
                                Click="OffsetReset_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2"
                    Padding="14,10"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0 1 0 0">
                <Button x:Name="DoneButton"
                        Content="Concluído"
                        HorizontalAlignment="Right"
                        Width="110" Height="34"
                        Foreground="{StaticResource BgApp}"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Done_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    CornerRadius="9"
                                    Background="{StaticResource Accent}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                            Property="Background"
                                            Value="{StaticResource AccentHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
