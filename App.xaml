<Application x:Class="LoLIdleDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ===== Tema: ArdÃ³sia + Cobre (1Âª passada) ===== -->
        <SolidColorBrush x:Key="BgApp"        Color="#171A21" />
        <SolidColorBrush x:Key="BgPanel"      Color="#1C2129" />
        <SolidColorBrush x:Key="BgPanel2"     Color="#222733" />
        <SolidColorBrush x:Key="BgPanel3"     Color="#262C39" />
        <SolidColorBrush x:Key="TextPrimary"  Color="#D6DAE6" />
        <SolidColorBrush x:Key="TextSecondary" Color="#93A0B4" />
        <SolidColorBrush x:Key="TextDim"      Color="#6B7689" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#2B313F" />
        <SolidColorBrush x:Key="BorderSoft"   Color="#3A4254" />
        <SolidColorBrush x:Key="Accent"       Color="#D97B36" />
        <SolidColorBrush x:Key="AccentHover"  Color="#E8903F" />
        <SolidColorBrush x:Key="AccentSoft"   Color="#3A2A1C" />
        <SolidColorBrush x:Key="AccentIce"    Color="#4FD1D9" />
        <SolidColorBrush x:Key="Success"      Color="#3BAF6B" />
        <SolidColorBrush x:Key="Danger"       Color="#E05B4B" />
        <SolidColorBrush x:Key="Warning"      Color="#E08F1F" />

        <!-- Corpo do app em Barlow; tÃ­tulos usam Rajdhani localmente -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="pack://application:,,,/Assets/Fonts/Barlow-Regular.ttf#Barlow" />
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border x:Name="box"
                                    Width="17" Height="17"
                                    CornerRadius="4"
                                    Background="{StaticResource BorderSubtle}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="check"
                                      Data="M 3 8.6 L 6.6 12 L 13.5 4.3"
                                      Stroke="{StaticResource Accent}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="12.5" Height="10"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter x:Name="content"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource BorderSubtle}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource BorderSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
