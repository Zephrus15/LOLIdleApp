<Window x:Class="LoLIdleDesktop.HudCompactaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Idle — HUD"
        Width="248"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="{DynamicResource BgPanel2}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1">
        <Grid x:Name="Root"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RootTranslate" X="0" Y="0" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: ícone + HUD + fixar/soltar + X (arrastável pelo header) -->
            <Grid Grid.Row="0"
                  Margin="10,8,8,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Cursor="Hand">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Canvas Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                    <Path Stroke="{StaticResource Accent}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"
                          Data="M 2 11 L 2 6 L 5 6 L 5 11 M 6 11 L 6 2 L 9 2 L 9 11 M 10 11 L 10 8 L 13 8 L 13 11" />
                </Canvas>
                <TextBlock Grid.Column="1"
                           Text="HUD"
                           FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
                <Button x:Name="HudPinButton"
                        Grid.Column="2"
                        Style="{StaticResource GhostIconButton}"
                        Width="26" Height="26"
                        VerticalAlignment="Center"
                        ToolTip="Fixar na frente"
                        Click="HudPinButton_Click">
                    <Canvas Width="12" Height="12">
                        <Path x:Name="PinPath"
                              Fill="#D97B36"
                              Stretch="Uniform"
                              Width="12" Height="12"
                              Data="M3 1 H9 V5 L11 10 V12 H7.5 V16 L6 17.5 L4.5 16 V12 H1 V10 L3 5 Z" />
                    </Canvas>
                </Button>
                <Button x:Name="HudCloseButton"
                        Grid.Column="3"
                        Style="{StaticResource GhostIconButton}"
                        Width="26" Height="26"
                        VerticalAlignment="Center"
                        ToolTip="Fechar (esconder)"
                        Click="HudCloseButton_Click">
                    <Canvas Width="11" Height="11">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              Data="M 2.5 2.5 L 8.5 8.5 M 8.5 2.5 L 2.5 8.5" />
                    </Canvas>
                </Button>
            </Grid>

            <!-- Stats: ouro -->
            <Grid Grid.Row="1"
                  Margin="12,10,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Canvas Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Path Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.3"
                          Fill="Transparent"
                          Data="M7 1.5 a5.5 5.5 0 1 1 0 11 a5.5 5.5 0 1 1 0 -11 z" />
                </Canvas>
                <TextBlock Grid.Column="1"
                           Text="Ouro"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="OuroText"
                           Grid.Column="2"
                           Text="—"
                           FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Mochila -->
            <Grid Grid.Row="2"
                  Margin="12,0,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Canvas Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Path Stroke="{DynamicResource TextSecondary}"
                          StrokeThickness="1.3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Fill="Transparent"
                          Data="M4 6h8v6a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2z M6 6V4a2 2 0 0 1 4 0v2" />
                </Canvas>
                <TextBlock Grid.Column="1"
                           Text="Mochila"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="MochilaText"
                           Grid.Column="2"
                           Text="—"
                           FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Separador mochila / tarefa -->
            <Border Grid.Row="3"
                    Height="1"
                    Background="{DynamicResource BorderSubtle}"
                    Margin="12,2,12,6" />

            <!-- Tarefa atual -->
            <StackPanel Grid.Row="4"
                        Margin="12,2,12,12">
                <TextBlock Text="TAREFA"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="TarefaText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           Text="—" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
