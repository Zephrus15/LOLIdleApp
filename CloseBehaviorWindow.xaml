<Window x:Class="LoLIdleDesktop.CloseBehaviorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opções de fechamento"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="14"
            Background="#161922"
            BorderBrush="#2F3540"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    Padding="18,10,10,10"
                    Background="#1E212B"
                    BorderBrush="#22262F"
                    BorderThickness="0 0 0 1">
                <Grid>
                    <TextBlock Text="⚙ Opções de fechamento"
                               Foreground="#F2F2F2"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseHeaderButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Content="✕"
                            ToolTip="Fechar"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHeader_Click" />
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="18,16,18,10">
                <TextBlock Text="Comportamento do botão Fechar do app."
                           Foreground="#9298A5"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <!-- Opção 1: sempre perguntar -->
                <Border Background="#1B1E27"
                        BorderBrush="#2A2E38"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <CheckBox x:Name="AskCheck"
                              Style="{StaticResource DarkCheckBox}"
                              VerticalContentAlignment="Center"
                              Checked="Option_Checked"
                              Unchecked="Option_Unchecked">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sempre perguntar"
                                       Foreground="#F2F2F2"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Abre o diálogo 'Fechar o LoL Idle?' toda vez que clicar em Fechar"
                                       Foreground="#9298A5"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- Opção 2: continuar em segundo plano -->
                <Border Background="#1B1E27"
                        BorderBrush="#2A2E38"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <CheckBox x:Name="BackgroundCheck"
                              Style="{StaticResource DarkCheckBox}"
                              VerticalContentAlignment="Center"
                              Checked="Option_Checked"
                              Unchecked="Option_Unchecked">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sempre continuar em segundo plano"
                                       Foreground="#F2F2F2"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Fecha direto para a bandeja; o jogo continua farmando" />
                                       Foreground="#9298A5"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <!-- Opção 3: sair e desligar -->
                <Border Background="#1B1E27"
                        BorderBrush="#2A2E38"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,4">
                    <CheckBox x:Name="ExitCheck"
                              Style="{StaticResource DarkCheckBox}"
                              VerticalContentAlignment="Center"
                              Checked="Option_Checked"
                              Unchecked="Option_Unchecked">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Sempre sair e desligar as contas"
                                       Foreground="#F2F2F2"
                                       FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Encerra o app e desliga todas as contas"
                                       Foreground="#9298A5"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </CheckBox>
                </Border>

                <TextBlock Text="A mudança vale na hora e fica salva para as próximas vezes."
                           Foreground="#9298A5"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="2,6,0,0" />
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2"
                    Padding="14,12"
                    BorderBrush="#22262F"
                    BorderThickness="0 1 0 0">
                <Grid>
                    <Button x:Name="DoneButton"
                            Content="Concluído"
                            HorizontalAlignment="Right"
                            Width="110" Height="36"
                            Foreground="#0A2E19"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Done_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="9"
                                        Background="#2BD46A">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="#36E67D" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
