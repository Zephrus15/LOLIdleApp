<Window x:Class="LoLIdleDesktop.NotifySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notificações"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="8"
            Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    Padding="18,10,10,10"
                    Background="{StaticResource BgPanel2}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0 0 0 1">
                <Grid>
                    <TextBlock Text="🔔 Notificações"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseHeaderButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Content="✕"
                            ToolTip="Concluir"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHeader_Click" />
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="18,16,18,10">
                <!-- Ativar/desativar global -->
                <Border Background="{StaticResource BgPanel2}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <CheckBox x:Name="NotifyEnabledCheck"
                              Style="{StaticResource DarkCheckBox}"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Checked="NotifyEnabledCheck_Changed"
                              Unchecked="NotifyEnabledCheck_Changed">
                        <TextBlock Text="Ativar notificações" TextWrapping="Wrap" />
                    </CheckBox>
                </Border>

                <!-- Contas que notificam -->
                <TextBlock Text="Notificar de:"
                           Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="2,0,0,6" />
                <StackPanel x:Name="ContasListPanel" Margin="0,0,0,12">
                    <!-- Checkboxes por conta gerados no code-behind -->
                </StackPanel>

                <!-- Tipos de notificação -->
                <TextBlock Text="Tipos de notificação:"
                           Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="2,0,0,6" />
                <StackPanel x:Name="TypesListPanel">
                    <!-- Checkboxes por tipo gerados no code-behind -->
                </StackPanel>

                <TextBlock x:Name="MultiAccountHint"
                           Margin="2,10,0,0"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"
                           Text="Quando mais de uma conta está marcada, o balão mostra o nome da conta que gerou o aviso (ex: Yasuo — Missão concluída!)." />
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2"
                    Padding="14,12"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0 1 0 0">
                <Grid>
                    <Button x:Name="DoneButton"
                            Content="Concluído"
                            HorizontalAlignment="Right"
                            Width="110" Height="36"
                            Foreground="{StaticResource BgApp}"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Done_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="9"
                                        Background="{StaticResource Accent}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{StaticResource AccentHover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
