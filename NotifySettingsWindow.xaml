<Window x:Class="LoLIdleDesktop.NotifySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notificações"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8DCE4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border x:Name="box"
                                    Width="17" Height="17"
                                    CornerRadius="4"
                                    Background="#2A2E38"
                                    BorderBrush="#3A404C"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="check"
                                      Data="M 3 8.6 L 6.6 12 L 13.5 4.3"
                                      Stroke="#2BD46A"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="12.5" Height="10"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter x:Name="content"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#4C535F" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#22442C" />
                                <Setter TargetName="box" Property="BorderBrush" Value="#2BD46A" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="14"
            Background="#161922"
            BorderBrush="#2F3540"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    Padding="18,10,10,10"
                    Background="#1E212B"
                    BorderBrush="#22262F"
                    BorderThickness="0 0 0 1">
                <Grid>
                    <TextBlock Text="🔔 Notificações"
                               Foreground="#F2F2F2"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseHeaderButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Content="✕"
                            ToolTip="Concluir"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHeader_Click" />
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="18,16,18,10">
                <!-- Ativar/desativar global -->
                <Border Background="#1B1E27"
                        BorderBrush="#2A2E38"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Margin="0,0,0,10">
                    <CheckBox x:Name="NotifyEnabledCheck"
                              Style="{StaticResource DarkCheckBox}"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Checked="NotifyEnabledCheck_Changed"
                              Unchecked="NotifyEnabledCheck_Changed">
                        <TextBlock Text="Ativar notificações" TextWrapping="Wrap" />
                    </CheckBox>
                </Border>

                <!-- Contas que notificam -->
                <TextBlock Text="Notificar de:"
                           Foreground="#E8CF8F"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="2,0,0,6" />
                <StackPanel x:Name="ContasListPanel" Margin="0,0,0,12">
                    <!-- Checkboxes por conta gerados no code-behind -->
                </StackPanel>

                <!-- Tipos de notificação -->
                <TextBlock Text="Tipos de notificação:"
                           Foreground="#E8CF8F"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="2,0,0,6" />
                <StackPanel x:Name="TypesListPanel">
                    <!-- Checkboxes por tipo gerados no code-behind -->
                </StackPanel>

                <TextBlock x:Name="MultiAccountHint"
                           Margin="2,10,0,0"
                           FontSize="11"
                           Foreground="#9298A5"
                           TextWrapping="Wrap"
                           Text="Quando mais de uma conta está marcada, o balão mostra o nome da conta que gerou o aviso (ex: Mio — Missão concluída!)." />
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2"
                    Padding="14,12"
                    BorderBrush="#22262F"
                    BorderThickness="0 1 0 0">
                <Grid>
                    <!-- Rodapé: apenas o botão Concluído (à direita) -->
                    <Button x:Name="DoneButton"
                            Content="Concluído"
                            HorizontalAlignment="Right"
                            Width="110" Height="36"
                            Foreground="#0A2E19"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Done_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="9"
                                        Background="#2BD46A">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="#36E67D" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
