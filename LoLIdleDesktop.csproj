<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LoL Idle</AssemblyName>
    <ApplicationIcon>Assets\lol-idle.ico</ApplicationIcon>
    <RootNamespace>LoLIdleDesktop</RootNamespace>
    <Version>1.4.9</Version>
    <AssemblyVersion>1.4.9.0</AssemblyVersion>
    <FileVersion>1.4.9.0</FileVersion>
    <InformationalVersion>1.4.9</InformationalVersion>
    <!-- Entry point explícito (Program.Main) para o VelopackApp.Build().Run() rodar
         antes de qualquer WPF. App.xaml vira Page (ver ItemGroup abaixo). -->
    <StartupObject>LoLIdleDesktop.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml deixa de ser ApplicationDefinition (que gera um Main WPF próprio) e
         passa a ser Page; o Main explícito fica em Program.cs e chama
         VelopackApp.Build().Run() antes do WPF subir. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\lol-idle.ico" />
    <Resource Include="Assets\notify_legendary.wav" />
    <Resource Include="Assets\notify_mission.wav" />
    <Resource Include="Assets\notify_level.wav" />
    <Resource Include="Assets\notify_inventory.wav" />
    <Resource Include="Assets\notify_epic.wav" />
    <Resource Include="Assets\notify_potion.wav" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <EmbeddedResource Include="Assets\Champions\*.png" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
