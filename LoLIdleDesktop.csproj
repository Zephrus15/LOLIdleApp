<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LoL Idle</AssemblyName>
    <ApplicationIcon>Assets\lol-idle.ico</ApplicationIcon>
    <RootNamespace>LoLIdleDesktop</RootNamespace>
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <InformationalVersion>1.2.1</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\lol-idle.ico" />
    <Resource Include="Assets\notify_legendary.wav" />
    <Resource Include="Assets\notify_mission.wav" />
    <Resource Include="Assets\notify_level.wav" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
</Project>
