<Window x:Class="LoLIdleDesktop.AlterarAvatarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alterar avatar"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Slider de zoom escuro, com indicador de progresso (trilha preenchida) -->
        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="{StaticResource Accent}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="{StaticResource BorderSubtle}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="8"
                                                        Background="{StaticResource Accent}"
                                                        BorderBrush="{StaticResource BgApp}"
                                                        BorderThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Cancelar discreto -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="{StaticResource BgPanel2}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderSubtle}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    Padding="16,10,10,10"
                    Background="{StaticResource BgPanel2}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0 0 0 1">
                <Grid>
                    <TextBlock Text="Alterar avatar"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                               VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Content="✕"
                            ToolTip="Cancelar"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHeader_Click" />
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="18,16,18,12">
                <TextBlock Text="Arraste a imagem para reposicionar"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="2,0,0,8" />

                <!-- Preview 300x300 (recorte quadrado com bordas arredondadas) -->
                <Border x:Name="PreviewBorder"
                        Width="300" Height="300"
                        HorizontalAlignment="Center"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Background="{StaticResource BgPanel2}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                        MouseMove="Preview_MouseMove"
                        MouseLeftButtonUp="Preview_MouseLeftButtonUp">
                    <!-- Clip arredondado: recorta o conteúdo (Canvas + Image) nos cantos,
                         já que ClipToBounds só corta no retângulo. -->
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,300,300" RadiusX="14" RadiusY="14" />
                    </Border.Clip>
                    <!-- Conteúdo (Canvas + Image) criado no code-behind -->
                </Border>

                <!-- Zoom -->
                <TextBlock Text="Zoom"
                           Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="2,14,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="−"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Slider x:Name="ZoomSlider"
                            Grid.Column="1"
                            Style="{StaticResource ZoomSliderStyle}"
                            Minimum="1.0"
                            Maximum="4.0"
                            SmallChange="0.05"
                            LargeChange="0.25"
                            VerticalAlignment="Center"
                            ValueChanged="ZoomSlider_ValueChanged" />
                    <TextBlock Grid.Column="2"
                               Text="+"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <TextBlock x:Name="ZoomValueText"
                               Grid.Column="3"
                               Text="1.0x"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <!-- Pré-visualização na barra lateral (mini-chip idêntico ao da sidebar) -->
                <TextBlock Text="Pré-visualização na barra lateral"
                           Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="2,14,0,6" />
                <Border x:Name="SidebarPreviewChip"
                        Background="{StaticResource BgPanel2}"
                        CornerRadius="6"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Avatar 40x40 recriado via MainWindow.CriarAvatarVisual (igual ao chip) -->
                        <Grid x:Name="SidebarPreviewHost"
                              Width="40" Height="40"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <TextBlock x:Name="SidebarPreviewName"
                                       Text="Conta"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SidebarPreviewSubtitle"
                                       Text="segundo plano"
                                       Foreground="#6E9CD8"
                                       FontSize="10"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2"
                    Padding="14,12"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0 1 0 0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancelar"
                            Width="100" Height="36"
                            Padding="14,0"
                            Margin="0,0,8,0"
                            Style="{StaticResource CancelButtonStyle}"
                            Click="Cancel_Click" />
                    <Button x:Name="ApplyButton"
                            Content="Aplicar"
                            Width="110" Height="36"
                            Foreground="{StaticResource BgApp}"
                            BorderThickness="0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Apply_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="9"
                                        Background="{StaticResource Accent}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{StaticResource AccentHover}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{StaticResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
