<Window x:Class="LoLIdleDesktop.HuntWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Hunt for LoL Idle"
        Width="400"
        Height="640"
        MinWidth="340"
        MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Border CornerRadius="10"
            Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho (arrastar a janela) -->
            <Border Grid.Row="0"
                    x:Name="HeaderBorder"
                    Padding="14,8"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="🏹 Hunt for LoL Idle"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                               VerticalAlignment="Center" />
                    <Button x:Name="HuntUpdateButton"
                            Click="HuntUpdate_Click"
                            Visibility="Collapsed"
                            Style="{StaticResource GhostIconButton}"
                            Foreground="{StaticResource AccentHover}"
                            Content="↻ Atualizar"
                            FontFamily="Barlow"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Padding="10,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,36,0"
                            ToolTip="Atualizar Hunt for LoL Idle" />
                    <Button x:Name="CloseHuntButton"
                            Content="✕"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTip="Fechar"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHuntButton_Click" />
                </Grid>
            </Border>

            <!-- Corpo: WebView2 da extensão + moldura amigável enquanto instala/carrega -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="HuntView" />

                <Grid x:Name="LoadingOverlay"
                      Background="{StaticResource BgPanel}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="24">
                        <TextBlock x:Name="LoadingText"
                                   Text="Instalando Hunt for LoL Idle…"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <ProgressBar x:Name="InstallProgress"
                                     IsIndeterminate="True"
                                     Width="180"
                                     Height="4"
                                     Foreground="{StaticResource Accent}"
                                     Background="{StaticResource BorderSubtle}"
                                     BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
