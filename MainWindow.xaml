<Window x:Class="LoLIdleDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LoL Idle"
        Width="1280" Height="800"
        MinWidth="480" MinHeight="320"
        WindowStyle="None"
        Background="#111318"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D8DCE4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#343A46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B35"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#30343D"
            BorderThickness="1"
            Background="#111318">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Grid Grid.Row="0"
                  Background="#191C23"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">

                    <TextBlock Text="⚔"
                               FontSize="17"
                               Foreground="#D8B45A"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>

                    <TextBlock Text="LoL Idle"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F2F2F2"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  •  Aplicativo desktop"
                               FontSize="11"
                               Foreground="#9298A5"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="—"
                        Click="Minimize_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Minimizar para a barra de tarefas"/>

                <Button Grid.Column="2"
                        x:Name="MaximizeButton"
                        Content="□"
                        Click="Maximize_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Maximizar"/>

                <Button Grid.Column="3"
                        Content="×"
                        Click="Close_Click"
                        Style="{StaticResource CloseButton}"
                        ToolTip="Fechar para a bandeja"/>
            </Grid>

            <!-- Área do jogo + barra lateral de contas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
                </Grid.ColumnDefinitions>

                <wv2:WebView2 x:Name="GameView"
                              Grid.Column="0"
                              DefaultBackgroundColor="#111318"/>

                <!-- Toggle esconder/mostrar barra lateral -->
                <Button Grid.Column="1"
                        x:Name="SidebarToggleButton"
                        Click="SidebarToggle_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Esconder contas">
                    <TextBlock Text="◀"
                               FontSize="12"
                               Foreground="#D8DCE4"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>

                <!-- Barra lateral: contas -->
                <Border x:Name="SidebarPanel"
                        Grid.Column="2"
                        Background="#161922"
                        BorderBrush="#30343D"
                        BorderThickness="1 0 0 0">
                    <StackPanel Margin="14">
                        <TextBlock Text="Contas"
                                   Foreground="#E8CF8F"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TabControl x:Name="ContasTabControl">
                            <TabControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </TabControl.ItemsPanel>

                            <TabItem Header="Conta 1">
                                <TextBlock Text="Zephrus" Foreground="#D8DCE4" FontSize="12" Margin="8,4"/>
                            </TabItem>

                            <TabItem Header="Conta 2">
                                <TextBlock Text="Convidado" Foreground="#D8DCE4" FontSize="12" Margin="8,4"/>
                            </TabItem>
                        </TabControl>

                        <Button x:Name="AddAccountButton"
                                Content="➕ Adicionar conta"
                                Click="AddAccount_Click"
                                Foreground="#D8DCE4"
                                Background="#2A2E38"
                                BorderBrush="#D8B45A"
                                BorderThickness="1"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                FontSize="12"/>

                        <TextBlock x:Name="ContasCountText" Text="Contas: 0 / 4"
                                   Foreground="#9298A5"
                                   FontSize="12"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Mantido oculto para preservar as referências do code-behind. -->
            <TextBlock x:Name="StatusText"
                       Visibility="Collapsed"
                       Text="Preparando o jogo..."/>
        </Grid>
    </Border>
</Window>
