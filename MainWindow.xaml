<Window x:Class="LoLIdleDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Idle"
        Width="1280" Height="800"
        MinWidth="480" MinHeight="320"
        WindowStyle="None"
        Background="#111318"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <Style x:Key="AddAccountButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D8DCE4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="9"
                                Padding="8,6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F222B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#252A34"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D8DCE4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2E38"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#343A46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C42B35"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#30343D"
            BorderThickness="1"
            Background="#111318">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Grid Grid.Row="0"
                  Background="#191C23"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">

                    <TextBlock Text="⚔"
                               FontSize="17"
                               Foreground="#D8B45A"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>

                    <TextBlock Text="LoL Idle"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F2F2F2"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  •  Aplicativo desktop"
                               FontSize="11"
                               Foreground="#9298A5"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="Minimize_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Minimizar para a barra de tarefas"
                        Width="36" Height="34">
                    <Canvas Width="14" Height="10">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              Data="M 2 5 L 12 5"/>
                    </Canvas>
                </Button>

                <Button Grid.Column="2"
                        x:Name="MaximizeButton"
                        Click="Maximize_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Maximizar"
                        Width="36" Height="34">
                    <Canvas Width="13" Height="13">
                        <Path x:Name="MaximizeIcon"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              Data="M 1.5 1.5 H 11.5 V 11.5 H 1.5 Z"/>
                        <Path x:Name="RestoreIcon"
                              Visibility="Collapsed"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              Data="M 1 5 H 9 V 12 H 1 Z M 4 1 H 12 V 8 H 4 Z"/>
                    </Canvas>
                </Button>

                <Button Grid.Column="3"
                        Click="Close_Click"
                        Style="{StaticResource CloseButton}"
                        ToolTip="Fechar para a bandeja"
                        Width="36" Height="34">
                    <Canvas Width="14" Height="14">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              Data="M 2.5 2.5 L 11.5 11.5 M 11.5 2.5 L 2.5 11.5"/>
                    </Canvas>
                </Button>
            </Grid>

            <!-- Área do jogo + barra lateral de contas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SidebarRailColumn" Width="28"/>
                    <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Host dos WebViews de conta (um por conta, sobrepostos; só o ativo fica visível) -->
                <Grid x:Name="AccountViewHost"
                      Grid.Column="0"/>

                <!-- Faixa vertical de avatares (visível só quando a sidebar está minimizada) + toggle -->
                <Grid Grid.Column="1">
                    <StackPanel x:Name="SidebarRailPanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"/>

                    <Button x:Name="SidebarToggleButton"
                            Click="SidebarToggle_Click"
                        Style="{StaticResource GhostIconButton}"
                        ToolTip="Esconder contas"
                        Width="26" Height="36"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <Canvas Width="11" Height="11">
                        <Path x:Name="SidebarToggleLeftIcon"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              Data="M 7.5 2 L 3 5.5 L 7.5 9"/>
                        <Path x:Name="SidebarToggleRightIcon"
                              Visibility="Collapsed"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              Data="M 3.5 2 L 8 5.5 L 3.5 9"/>
                    </Canvas>
                    </Button>
                </Grid>

                <!-- Barra lateral: contas -->
                <Border x:Name="SidebarPanel"
                        Grid.Column="2"
                        Background="#161922"
                        BorderBrush="#30343D"
                        BorderThickness="1 0 0 0">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="ContasHideButton"
                            Grid.Row="0"
                            Content="Contas ▴"
                            Click="ContasHide_Click"
                            Style="{StaticResource AddAccountButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            ToolTip="Esconder/mostrar contas"/>

                        <StackPanel x:Name="ContasStripPanel"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Vertical"/>

                        <Grid x:Name="ContasListPanel" Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                                <StackPanel x:Name="ContasWrapPanel"
                                            Margin="0,4,0,0">
                                    <!-- Os itens são gerados dinamicamente no code-behind -->
                                </StackPanel>

                                <Button x:Name="AddAccountButton"
                                        Content="➕ Adicionar conta"
                                        Click="AddAccount_Click"
                                        ToolTip="Cria uma nova aba de conta. Faça login nela; a sessão fica salva neste computador."
                                        Style="{StaticResource AddAccountButtonStyle}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        FontSize="12"/>

                                <TextBlock x:Name="ContasCountText" Text="Contas: 1 / 4"
                                           Foreground="#9298A5"
                                           FontSize="12"
                                           Margin="0,8,0,0"/>

                                <Button x:Name="NotificationsButton"
                                        Content="🔔 Notificações"
                                        Click="Notifications_Click"
                                        ToolTip="Configurar como os avisos do jogo chegam (conta, tipo, ativar/desativar)"
                                        Style="{StaticResource AddAccountButtonStyle}"
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Left"
                                        FontSize="12"/>

                                <Button x:Name="CloseBehaviorButton"
                                        Content="⚙ Opções de fechamento"
                                        Click="CloseBehavior_Click"
                                        ToolTip="Escolher o que acontece ao clicar em Fechar"
                                        Style="{StaticResource AddAccountButtonStyle}"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        FontSize="12"/>
                            </StackPanel>

                            <StackPanel x:Name="NotificacoesRecentesPanel"
                                        Grid.Row="1"
                                        VerticalAlignment="Bottom"
                                        Margin="0,16,0,0">
                                <Grid x:Name="NotificacoesRecentesTituloRow" Margin="0,0,0,4" Visibility="Collapsed">
                                    <TextBlock x:Name="NotificacoesRecentesTitulo" Text="ÚLTIMAS NOTIFICAÇÕES"
                                               Foreground="#E8CF8F" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,0"/>
                                    <Button x:Name="LimparNotificacoesButton"
                                            Content="Limpar"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource GhostIconButton}"
                                            FontSize="11" Padding="8,2"
                                            ToolTip="Apagar as últimas notificações (as marcações de não lido não são afetadas)"
                                            Click="LimparNotificacoes_Click"/>
                                </Grid>
                                <TextBlock x:Name="NotificacoesRecentesVazio" Text="Nenhuma notificação recente."
                                           Foreground="#6E7480" FontSize="11" Margin="2,0,0,0"/>
                                <StackPanel x:Name="NotificacoesRecentesList" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mantido oculto para preservar as referências do code-behind. -->
            <TextBlock x:Name="StatusText"
                       Visibility="Collapsed"
                       Text="Preparando o jogo..."/>
        </Grid>
    </Border>
</Window>
