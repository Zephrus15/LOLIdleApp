
<Window x:Class="LoLIdleDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LoL Idle"
        Width="1280" Height="800"
        MinWidth="480" MinHeight="320"
        WindowStyle="None"
        Background="#111318"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D8DCE4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#343A46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B35"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#30343D"
            BorderThickness="1"
            Background="#111318">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="22"/>
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Grid Grid.Row="0"
                  Background="#191C23"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">

                    <TextBlock Text="⚔"
                               FontSize="17"
                               Foreground="#D8B45A"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>

                    <TextBlock Text="LoL Idle"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F2F2F2"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  •  Aplicativo desktop"
                               FontSize="11"
                               Foreground="#9298A5"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Modo compacto -->
                <Button Grid.Column="1"
                        Content="▣"
                        Click="Compact_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Alternar modo compacto"/>

                <!-- Minimizar normalmente para a barra de tarefas -->
                <Button Grid.Column="2"
                        Content="—"
                        Click="Minimize_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Minimizar para a barra de tarefas"/>

                <Button Grid.Column="3"
                        Content="□"
                        Click="Maximize_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Maximizar"/>

                <Button Grid.Column="4"
                        Content="×"
                        Click="Close_Click"
                        Style="{StaticResource CloseButton}"
                        ToolTip="Fechar para a bandeja"/>
            </Grid>

            <!-- Área do jogo -->
            <wv2:WebView2 x:Name="GameView"
                          Grid.Row="1"
                          DefaultBackgroundColor="#111318"/>

            <!-- Barra de status -->
            <Grid Grid.Row="2"
                  Background="#191C23">

                <TextBlock x:Name="StatusText"
                           Text="Preparando o jogo..."
                           Foreground="#9AA1AE"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="10,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
