<Window x:Class="LoLIdleDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Idle"
        Width="1280" Height="800"
        MinWidth="480" MinHeight="320"
        WindowStyle="None"
        Background="{StaticResource BgApp}"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <Style x:Key="AddAccountButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="9"
                                Padding="8,6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgPanel2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgPanel3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LimparCacheButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D6DAE6"/>
            <Setter Property="Background" Value="#1B1E27"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Padding="10,9"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#232833"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#262C39"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5E6272"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderSubtle}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C42B35"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1"
            Background="{StaticResource BgApp}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Grid Grid.Row="0"
                  Background="{StaticResource BgPanel}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">

                    <TextBlock Text="⚔"
                               FontSize="17"
                               Foreground="#D8B45A"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>

                    <TextBlock Text="LoL Idle"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="  •  Aplicativo desktop"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Click="HuntTitle_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Hunt for LoL Idle (painel de zonas e builds)"
                        Width="36" Height="34">
                    <Canvas Width="14" Height="14">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              Data="M 7 1.5 V 4.5 M 7 9.5 V 12.5 M 1.5 7 H 4.5 M 9.5 7 H 12.5 M 7 7 m -3.2 0 a 3.2 3.2 0 1 0 6.4 0 a 3.2 3.2 0 1 0 -6.4 0"/>
                    </Canvas>
                </Button>

                <Button Grid.Column="2"
                        Click="Minimize_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Minimizar para a barra de tarefas"
                        Width="36" Height="34">
                    <Canvas Width="14" Height="10">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              Data="M 2 5 L 12 5"/>
                    </Canvas>
                </Button>

                <Button Grid.Column="3"
                        x:Name="MaximizeButton"
                        Click="Maximize_Click"
                        Style="{StaticResource WindowButton}"
                        ToolTip="Maximizar"
                        Width="36" Height="34"/>

                <Button Grid.Column="4"
                        Click="Close_Click"
                        Style="{StaticResource CloseButton}"
                        ToolTip="Fechar para a bandeja"
                        Width="36" Height="34">
                    <Canvas Width="14" Height="14">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              Data="M 2.5 2.5 L 11.5 11.5 M 11.5 2.5 L 2.5 11.5"/>
                    </Canvas>
                </Button>
            </Grid>

            <!-- Área do jogo + barra lateral de contas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SidebarRailColumn" Width="28"/>
                    <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Host dos WebViews de conta (um por conta, sobrepostos; só o ativo fica visível) -->
                <Grid x:Name="AccountViewHost"
                      Grid.Column="0"/>

                <!-- Faixa vertical de avatares (visível só quando a sidebar está minimizada) + toggle -->
                <Grid Grid.Column="1">
                    <StackPanel x:Name="SidebarRailPanel"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Visibility="Collapsed"
                                Margin="0,8,0,0"/>

                    <Button x:Name="SidebarToggleButton"
                            Click="SidebarToggle_Click"
                        Style="{StaticResource GhostIconButton}"
                        ToolTip="Esconder barra lateral"
                        Width="26" Height="28"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,2,0">
                    <Canvas Width="11" Height="11">
                        <Path x:Name="SidebarToggleLeftIcon"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              Data="M 7.5 2 L 3 5.5 L 7.5 9"/>
                        <Path x:Name="SidebarToggleRightIcon"
                              Visibility="Collapsed"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              Data="M 3.5 2 L 8 5.5 L 3.5 9"/>
                    </Canvas>
                    </Button>
                </Grid>

                <!-- Barra lateral: contas -->
                <Border x:Name="SidebarPanel"
                        Grid.Column="2"
                        Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1 0 0 0">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="ContasHideButton"
                            Grid.Row="0"
                            Content="Contas ▴"
                            Click="ContasHide_Click"
                            Style="{StaticResource AddAccountButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                            FontSize="13"
                            ToolTip="Esconder/mostrar contas"/>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                                <WrapPanel x:Name="ContasStripPanel"
                                            Visibility="Collapsed"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"/>

                                <Grid x:Name="ContasListPanel">
                                    <StackPanel VerticalAlignment="Top">
                                        <StackPanel x:Name="ContasWrapPanel"
                                                    Margin="0,4,0,0">
                                            <!-- Os itens são gerados dinamicamente no code-behind -->
                                        </StackPanel>

                                        <Button Content="➕ Adicionar conta"
                                                Click="AddAccount_Click"
                                                ToolTip="Cria uma nova aba de conta. Faça login nela; a sessão fica salva neste computador."
                                                Style="{StaticResource AddAccountButtonStyle}"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                FontSize="12"/>

                                        <TextBlock x:Name="ContasCountText" Text="Contas: 1 / 4"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <Button Content="⚙ Ajustes"
                                            Click="Ajustes_Click"
                                            ToolTip="Central de configurações do app"
                                            Style="{StaticResource AddAccountButtonStyle}"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Left"
                                            FontSize="12"/>
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Consumo total"
                                               Foreground="#E8CF8F"
                                               FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="2,0,0,6"/>

                                    <!-- ===== Estado normal ===== -->
                                    <StackPanel x:Name="ConsumoTotalNormal">
                                        <Grid Margin="2,0,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                                <TextBlock Text="CPU"
                                                           Foreground="#5E6272"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="ConsumoCpuText"
                                                           Text="—"
                                                           Foreground="#2BD46A"
                                                           FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           Margin="0,-2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="RAM"
                                                           Foreground="#5E6272"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="ConsumoRamText"
                                                           Text="—"
                                                           Foreground="#D6DAE6"
                                                           FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                                                           FontSize="30"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,-2,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Height="10" Margin="2,6,2,0"
                                              ToolTip="Uso total de RAM do aplicativo (processo principal + WebView2; inclui páginas compartilhadas — é a métrica do app)">
                                            <Border Background="#262C39" CornerRadius="5"/>
                                            <Border x:Name="ConsumoRamFill"
                                                    Background="{StaticResource AccentIce}"
                                                    CornerRadius="5"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="ConsumoRamFillScale" ScaleX="0"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="2,6,2,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ConsumoMetaRefText"
                                                       Text="Meta de referência: 1,0 GB"
                                                       Foreground="#9298A5"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    x:Name="ConsumoMetaPill"
                                                    CornerRadius="9"
                                                    Padding="9,2"
                                                    Background="#2E2BD46A"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="ConsumoMetaPillText"
                                                           Text="Normal"
                                                           Foreground="#2BD46A"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <Button x:Name="LiberarEspacoButton"
                                                Content="⚡ Limpar cache"
                                                Click="LiberarEspaco_Click"
                                                ToolTip="Limpa arquivos temporários do WebView2. Cookies, sessão e progresso do jogo ficam intactos."
                                                Style="{StaticResource LimparCacheButtonStyle}"
                                                Margin="0,10,0,0"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <!-- ===== Resultado da limpeza ===== -->
                                    <StackPanel x:Name="ConsumoTotalResult" Visibility="Collapsed">
                                        <TextBlock Text="🧹 Limpeza de cache"
                                                   Foreground="#E8CF8F"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="2,0,0,6"/>
                                        <TextBlock x:Name="ConsumoResultValorText"
                                                   Text="—"
                                                   Foreground="#2BD46A"
                                                   FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                                                   FontSize="36"
                                                   FontWeight="SemiBold"
                                                   Margin="2,0,0,0"/>
                                        <TextBlock Text="Espaço em disco efetivamente liberado"
                                                   Foreground="#9298A5"
                                                   FontSize="12"
                                                   Margin="2,0,0,8"/>
                                        <Border HorizontalAlignment="Left"
                                                CornerRadius="9"
                                                Padding="9,2"
                                                Background="#2E2BD46A"
                                                Margin="2,0,0,6">
                                            <TextBlock Text="Limpeza concluída"
                                                       Foreground="#2BD46A"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock x:Name="ConsumoResultNotaText"
                                                   Text="Cookies, logins e progresso preservados."
                                                   Foreground="#5E6272"
                                                   FontSize="11"
                                                   Margin="2,0,0,0"/>
                                        <Button Content="Ok"
                                                Click="ConsumoResultOk_Click"
                                                ToolTip="Voltar"
                                                Style="{StaticResource GhostIconButton}"
                                                FontSize="11"
                                                Padding="10,2"
                                                Margin="0,4,2,0"
                                                HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <Border Background="{StaticResource BgPanel2}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                                        <StackPanel x:Name="ContasUsoList"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Bottom"
                                        Margin="-14,16,-14,0">
                                <Grid x:Name="NotificacoesRecentesTituloRow" Margin="0,0,14,4" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ÚLTIMAS NOTIFICAÇÕES"
                                               Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Foreground="#E8CF8F" FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani" FontSize="11" FontWeight="SemiBold" Margin="14,0,0,0"/>
                                    <Button Content="Limpar"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource GhostIconButton}"
                                            FontSize="11" Padding="8,2"
                                            ToolTip="Apagar as últimas notificações e as marcações de não lido de todas as contas"
                                            Click="LimparNotificacoes_Click"/>
                                </Grid>
                                <TextBlock x:Name="NotificacoesRecentesVazio" Text="Nenhuma notificação recente."
                                           Foreground="{StaticResource TextDim}" FontSize="11" Margin="14,0,0,0"/>
                                <StackPanel x:Name="NotificacoesRecentesList" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Barra de status (rodapé) -->
            <Border Grid.Row="2"
                    Height="30"
                    Background="{StaticResource BgApp}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <Border Background="{StaticResource BgPanel2}"
                                CornerRadius="6"
                                Padding="8,2"
                                Margin="0,0,8,0"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                ToolTip="Uso total de CPU do aplicativo (processo principal + WebView2)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="26" Height="4" Margin="0,0,2,0" VerticalAlignment="Center">
                                    <Border Background="#262C39" CornerRadius="2"/>
                                    <Border x:Name="FooterCpuFill" Background="{StaticResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock Text="CPU"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                                <TextBlock x:Name="FooterCpuText"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           Text="0.0%"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgPanel2}"
                                CornerRadius="6"
                                Padding="8,2"
                                Margin="0,0,8,0"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                ToolTip="Uso total de RAM do aplicativo (processo principal + WebView2; inclui páginas compartilhadas — é a métrica do app)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentIce}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                <TextBlock Text="RAM"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                                <TextBlock x:Name="FooterRamText"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           Text="—"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
