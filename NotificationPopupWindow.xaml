<Window x:Class="LoLIdleDesktop.NotificationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Idle — Notificação"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Border x:Name="RootBorder"
            CornerRadius="10"
            Background="{DynamicResource BgPanel2}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            Cursor="Hand"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseEnter="Root_MouseEnter"
            MouseLeave="Root_MouseLeave">
        <Grid x:Name="Root"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RootTranslate" X="400" Y="0" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Barra de acento (cobre) à esquerda -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Accent}"
                    CornerRadius="9,0,0,9" />

            <Grid Grid.Column="1" Margin="12,10,8,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Avatar da conta (40x40); preenchido no code-behind -->
                <ContentControl x:Name="AvatarHost"
                                Grid.Column="0"
                                Width="40" Height="40"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <TextBlock x:Name="TitleText"
                               FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MessageText"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="✕"
                        Style="{StaticResource GhostIconButton}"
                        Width="26" Height="26"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip="Fechar"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
