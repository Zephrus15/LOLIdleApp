<Window x:Class="LoLIdleDesktop.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fechar o LoL Idle?"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="14"
            Background="#161922"
            BorderBrush="#2F3540"
            BorderThickness="1"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    Padding="20,14"
                    BorderBrush="#22262F"
                    BorderThickness="0 0 0 1">
                <Grid>
                    <TextBlock Text="Fechar o LoL Idle?"
                               Foreground="#F2F2F2"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseHeaderButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="30" Height="30"
                            Content="✕"
                            ToolTip="Fechar"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHeader_Click" />
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="18,16">

                <!-- Opção 1: continuar rodando -->
                <Border x:Name="OptionSegundoPlano"
                        Background="#17292A"
                        BorderBrush="#1F8A4C"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="12,10"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="OptionSegundoPlano_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Background="#173B33"
                              Width="48" Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="▶"
                                       Foreground="#37D067"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <Ellipse x:Name="RadioSegundoPlano"
                                         Width="16" Height="16"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="0,1,0,0"
                                         Stroke="#37D067"
                                         StrokeThickness="2"
                                         Fill="#37D067" />
                                <TextBlock Text="Continuar rodando em segundo plano"
                                           Foreground="#F2F2F2"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="26,0,0,0" />
                            </Grid>
                            <TextBlock Text="A conta ligada segue farmando. O LoL Idle fica no ícone ao lado do relógio."
                                       Foreground="#9AA3B2"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="26,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Opção 2: sair -->
                <Border x:Name="OptionSair"
                        Background="#1B1E27"
                        BorderBrush="#2A2E38"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,10"
                        Cursor="Hand"
                        MouseLeftButtonDown="OptionSair_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Background="#40241F"
                              Width="48" Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Ícone de desligamento: círculo quase completo + linha vertical no topo -->
                            <Grid Width="22" Height="22"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
                                <Ellipse Width="20" Height="20"
                                         Stroke="#E05B4B"
                                         StrokeThickness="2.4"
                                         Fill="Transparent"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,-1.2" />
                                <Rectangle Width="3.6" Height="10"
                                           Fill="#40241F"
                                           VerticalAlignment="Top"
                                           Margin="0,-1,0,0" />
                                <Rectangle Width="2.8" Height="10"
                                           Fill="#E05B4B"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Center"
                                           Margin="0,-3,0,0" />
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <Ellipse x:Name="RadioSair"
                                         Width="16" Height="16"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="0,1,0,0"
                                         Stroke="#6B7280"
                                         StrokeThickness="2" />
                                <TextBlock Text="Sair e desligar as contas"
                                           Foreground="#EDEDED"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="26,0,0,0" />
                            </Grid>
                            <TextBlock Text="A conta para de farmar. O login continua salvo."
                                       Foreground="#9AA3B2"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="26,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lembrar -->
                <CheckBox x:Name="RememberCheckbox"
                          Content="Lembrar minha escolha e não perguntar de novo"
                          Margin="2,14,0,0"
                          Foreground="#C9CDD6"
                          FontSize="12"
                          VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2"
                    Padding="18,12"
                    BorderBrush="#22262F"
                    BorderThickness="0 1 0 0">
                <Grid>
                    <Button x:Name="CancelButton"
                            Content="Cancelar"
                            HorizontalAlignment="Left"
                            Width="110" Height="40"
                            Background="Transparent"
                            Foreground="#C9CDD6"
                            BorderThickness="0"
                            FontSize="13"
                            Cursor="Hand"
                            Click="Cancel_Click" />

                    <Button x:Name="ConfirmButton"
                            HorizontalAlignment="Right"
                            Width="220" Height="40"
                            Content="Fechar e continuar rodando"
                            Background="#2BD46A"
                            Foreground="#0A2E19"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Confirm_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="10"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Opacity"
                                                Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
