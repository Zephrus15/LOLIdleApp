<Window x:Class="LoLIdleDesktop.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fechar o LoL Idle?"
        Width="480"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="14"
            Background="#161922"
            BorderBrush="#2F3540"
            BorderThickness="1"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    Padding="20,14"
                    BorderBrush="#22262F"
                    BorderThickness="0 0 0 1">
                <Grid>
                    <TextBlock Text="Fechar o LoL Idle?"
                               Foreground="#F2F2F2"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseHeaderButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="30" Height="30"
                            Content="✕"
                            ToolTip="Fechar"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHeader_Click" />
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="18,16">

                <!-- Opção 1: continuar rodando -->
                <Border x:Name="OptionSegundoPlano"
                        Background="#17292A"
                        BorderBrush="#1F8A4C"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="12,12"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="OptionSegundoPlano_MouseLeftButtonDown"
                        MouseEnter="CardSegundoPlano_MouseEnter"
                        MouseLeave="CardSegundoPlano_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar do app: quadrado arredondado com triângulo de play centralizado -->
                        <Border Grid.Column="0"
                                Width="46" Height="46"
                                CornerRadius="12"
                                Background="#1E3A2F"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <Viewbox Stretch="Uniform"
                                     Margin="10,10,10,10"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Data="M 2 2 L 20 11 L 2 20 Z"
                                      Fill="#37D067"
                                      Stroke="#37D067"
                                      StrokeThickness="2.2"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Border>

                        <!-- Mesmo estilo do checkmark das Notificações -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="RadioSegundoPlano"
                                      Style="{StaticResource DarkCheckBox}"
                                      IsHitTestVisible="False"
                                      IsChecked="True"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Continuar rodando em segundo plano"
                                           Foreground="#F2F2F2"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="A conta ligada segue farmando. O LoL Idle fica no ícone ao lado do relógio."
                                           Foreground="#9AA3B2"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"
                                           MaxWidth="310" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Opção 2: sair -->
                <Border x:Name="OptionSair"
                        Background="#1B1E27"
                        BorderBrush="#2A2E38"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,12"
                        Cursor="Hand"
                        MouseLeftButtonDown="OptionSair_MouseLeftButtonDown"
                        MouseEnter="CardSair_MouseEnter"
                        MouseLeave="CardSair_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar vermelho escuro: símbolo de desligar centralizado no avatar -->
                        <Border Grid.Column="0"
                                Width="46" Height="46"
                                CornerRadius="12"
                                Background="#403033"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <Viewbox Stretch="Uniform"
                                     Margin="7,4,7,11"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Data="M 12 8 L 12 18 M 4.5 15 A 10 10 0 1 0 19.5 15"
                                      Stroke="#E05B4B"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent" />
                            </Viewbox>
                        </Border>

                        <!-- Mesmo estilo do checkmark das Notificações -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="RadioSair"
                                      Style="{StaticResource DarkCheckBox}"
                                      IsHitTestVisible="False"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sair e desligar as contas"
                                           Foreground="#EDEDED"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="A conta para de farmar. O login continua salvo."
                                           Foreground="#9AA3B2"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"
                                           MaxWidth="310" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lembrar -->
                <CheckBox x:Name="RememberCheckbox"
                          Content="Lembrar minha escolha e não perguntar de novo"
                          Margin="2,14,0,0"
                          Style="{StaticResource DarkCheckBox}"
                          FontSize="12"
                          VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2"
                    Padding="18,12"
                    BorderBrush="#22262F"
                    BorderThickness="0 1 0 0">
                <Grid>
                    <Button x:Name="CancelButton"
                            Content="Cancelar"
                            HorizontalAlignment="Left"
                            Width="110" Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#C9CDD6"
                            FontSize="13"
                            Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="10"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="#2A2E38" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="#343A46" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="ConfirmButton"
                            HorizontalAlignment="Right"
                            Width="220" Height="40"
                            Content="Fechar e continuar rodando"
                            Background="#2BD46A"
                            Foreground="#0A2E19"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Confirm_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="10"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Opacity"
                                                Value="0.85" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
