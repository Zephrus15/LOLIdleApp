<Window x:Class="LoLIdleDesktop.CloseConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fechar o LoL Idle?"
        Width="480"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Paleta azul local deste dialogo (selecao "segundo plano" + botao primario) -->
        <SolidColorBrush x:Key="DialogBlue"          Color="#5B8BD6" />
        <SolidColorBrush x:Key="DialogBlueHover"     Color="#6FA4E0" />
        <SolidColorBrush x:Key="DialogBlueSoft"      Color="#1E2B42" />
        <SolidColorBrush x:Key="DialogBlueSoftHover" Color="#1E3049" />
        <SolidColorBrush x:Key="ConfirmHoverBrush" Color="#6190D9" />
        <!-- CheckBox azul so para a opcao "segundo plano" deste dialogo -->
        <Style x:Key="BlueCheckBox" TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box"
                                    Width="17" Height="17"
                                    CornerRadius="4"
                                    Background="{StaticResource BorderSubtle}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="check"
                                      Data="M 3 8.6 L 6.6 12 L 13.5 4.3"
                                      Stroke="{StaticResource DialogBlue}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="12.5" Height="10"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter x:Name="content"
                                              Grid.Column="1"
                                              Margin="9,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource DialogBlueSoft}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource DialogBlue}" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border CornerRadius="8"
            Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSubtle}"
            BorderThickness="1"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    Padding="20,14"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0 0 0 1">
                <Grid>
                    <TextBlock Text="Fechar o LoL Idle?"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               FontFamily="pack://application:,,,/Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseHeaderButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="30" Height="30"
                            Content="✕"
                            ToolTip="Fechar"
                            Style="{StaticResource GhostIconButton}"
                            Click="CloseHeader_Click" />
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="18,16">

                <TextBlock Text="Selecione como fechar:"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           Margin="2,0,0,10" />

                <!-- Opção 1: continuar em segundo plano -->
                <Border x:Name="OptionSegundoPlano"
                        Background="{StaticResource DialogBlueSoft}"
                        BorderBrush="{StaticResource DialogBlue}"
                        BorderThickness="1.5"
                        CornerRadius="7"
                        Padding="12,12"
                        Cursor="Hand"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="OptionSegundoPlano_MouseLeftButtonDown"
                        MouseEnter="CardSegundoPlano_MouseEnter"
                        MouseLeave="CardSegundoPlano_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar do app: quadrado arredondado com triângulo de play centralizado -->
                        <Border Grid.Column="0"
                                Width="46" Height="46"
                                CornerRadius="7"
                                Background="{StaticResource DialogBlueSoft}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <Viewbox Stretch="Uniform"
                                     Margin="10,10,10,10"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Data="M 2 2 L 20 11 L 2 20 Z"
                                      Fill="{StaticResource DialogBlue}"
                                      Stroke="{StaticResource DialogBlueHover}"
                                      StrokeThickness="2.2"
                                      StrokeLineJoin="Round" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="RadioSegundoPlano"
                                      Style="{StaticResource BlueCheckBox}"
                                      IsHitTestVisible="False"
                                      IsChecked="True"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Continuar em segundo plano"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="O jogo continua farmando na bandeja; o LoL Idle fica ao lado do relógio."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"
                                           MaxWidth="310" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Opção 2: sair -->
                <Border x:Name="OptionSair"
                        Background="{StaticResource BgPanel2}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,12"
                        Cursor="Hand"
                        MouseLeftButtonDown="OptionSair_MouseLeftButtonDown"
                        MouseEnter="CardSair_MouseEnter"
                        MouseLeave="CardSair_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar vermelho escuro: símbolo de desligar centralizado no avatar -->
                        <Border Grid.Column="0"
                                Width="46" Height="46"
                                CornerRadius="7"
                                Background="#403033"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                            <Viewbox Stretch="Uniform"
                                     Margin="7,4,7,11"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Data="M 12 8 L 12 18 M 4.5 15 A 10 10 0 1 0 19.5 15"
                                      Stroke="#E05B4B"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <CheckBox x:Name="RadioSair"
                                      Style="{StaticResource DarkCheckBox}"
                                      IsHitTestVisible="False"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sair e desligar as contas"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="O app encerra e as contas desligam. O login continua salvo."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0"
                                           MaxWidth="310" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lembrar -->
                <CheckBox x:Name="RememberCheckbox"
                          Content="Lembrar minha escolha e não perguntar de novo"
                          Margin="2,14,0,0"
                          Style="{StaticResource DarkCheckBox}"
                          FontSize="12"
                          VerticalContentAlignment="Center" />
            </StackPanel>

            <!-- Rodapé -->
            <Border Grid.Row="2"
                    Padding="18,12"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0 1 0 0">
                <Grid>
                    <Button x:Name="CancelButton"
                            Content="Cancelar"
                            HorizontalAlignment="Left"
                            Width="110" Height="40"
                            Background="{StaticResource BgPanel2}"
                            BorderThickness="0"
                            Foreground="{StaticResource TextPrimary}"
                            FontSize="13"
                            Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="6"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{StaticResource BorderSubtle}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{StaticResource BorderSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="ConfirmButton"
                            HorizontalAlignment="Right"
                            Width="220" Height="40"
                            Content="Fechar e continuar rodando"
                            Background="{StaticResource DialogBlue}"
                            Foreground="{StaticResource BgApp}"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Confirm_Click">
                        <Button.FocusVisualStyle>
                            <Style TargetType="Control">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Control">
                                            <Border CornerRadius="8"
                                                    BorderThickness="2"
                                                    BorderBrush="{StaticResource DialogBlueHover}"
                                                    Background="Transparent"
                                                    Margin="-3" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.FocusVisualStyle>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        CornerRadius="6"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border"
                                                Property="Background"
                                                Value="{DynamicResource ConfirmHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
